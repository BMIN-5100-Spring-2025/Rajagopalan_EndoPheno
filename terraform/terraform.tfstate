    {
      "mode": "managed",
      "type": "aws_iam_policy",
      "name": "penn_student_iam_policy",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:iam::061051226319:policy/CustomPennStudentsPolicy",
            "attachment_count": 1,
            "description": "Grants minimally required IAM permissions to Penn students in BMIN 5100",
            "id": "arn:aws:iam::061051226319:policy/CustomPennStudentsPolicy",
            "name": "CustomPennStudentsPolicy",
            "name_prefix": "",
            "path": "/",
            "policy": "{\"Statement\":[{\"Action\":[\"s3:ListBucket\",\"s3:GetObject\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:s3:::bmin5100-terraform-state/*\",\"arn:aws:s3:::bmin5100-terraform-state\"],\"Sid\":\"AllowStudentsS3TerraformStateReadAccess\"},{\"Action\":[\"s3:PutObject\",\"s3:DeleteObject\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:s3:::bmin5100-terraform-state/${aws:username}-*/*\",\"arn:aws:s3:::bmin5100-terraform-state/${aws:username}-*\"],\"Sid\":\"AllowStudentsS3TerraformWriteAccess\"},{\"Action\":\"s3:*\",\"Condition\":{\"StringNotEquals\":{\"s3:bucketname\":\"bmin5100-terraform-state\"}},\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:s3:::*/*\",\"arn:aws:s3:::*\"],\"Sid\":\"AllowStudentsFullS3Access\"},{\"Action\":\"ecr:*\",\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"AllowStudentsECRFullAccess\"},{\"Action\":[\"iam:SetDefaultPolicyVersion\",\"iam:ListPolicyVersions\",\"iam:ListPolicies\",\"iam:ListEntitiesForPolicy\",\"iam:ListAttachedRolePolicies\",\"iam:GetPolicyVersion\",\"iam:GetPolicy\",\"iam:DeletePolicyVersion\",\"iam:DeletePolicy\",\"iam:CreatePolicyVersion\",\"iam:CreatePolicy\"],\"Effect\":\"Allow\",\"Resource\":\"arn:aws:iam::*:policy/*\",\"Sid\":\"AllowStudentsFullIAMForECSPolicy\"},{\"Action\":[\"iam:UpdateAssumeRolePolicy\",\"iam:PutRolePolicy\",\"iam:ListRoles\",\"iam:ListRolePolicies\",\"iam:ListInstanceProfilesForRole\",\"iam:ListEntitiesForPolicy\",\"iam:ListAttachedRolePolicies\",\"iam:GetRolePolicy\",\"iam:GetRole\",\"iam:DetachRolePolicy\",\"iam:DeleteRolePolicy\",\"iam:DeleteRole\",\"iam:CreateRole\",\"iam:AttachRolePolicy\"],\"Effect\":\"Allow\",\"Resource\":\"arn:aws:iam::*:role/*\",\"Sid\":\"AllowStudentsFullIAMForECSRole\"},{\"Action\":\"iam:PassRole\",\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"AllowStudentsIAMPassRole\"},{\"Action\":\"ecs:*\",\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"AllowStudentsECSFullAccess\"},{\"Action\":\"logs:*\",\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"AllowStudentsCloudWatchFullAccess\"},{\"Action\":[\"route53:*\",\"amplify:*\"],\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"AllowStudentsAmplifyFullAccess\"},{\"Action\":[\"lambda:CreateFunction\",\"lambda:*\",\"ec2:DescribeVpcs\",\"ec2:DescribeSubnets\",\"ec2:DescribeSecurityGroups\"],\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"AllowStudentsLambdaFullAccess\"},{\"Action\":\"apigateway:*\",\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"AllowStudentsApiGatewayFullAccess\"}],\"Version\":\"2012-10-17\"}",
            "policy_id": "ANPAQ4NXPZDH4YIMFAAHD",
            "tags": {},
            "tags_all": {}
          },
