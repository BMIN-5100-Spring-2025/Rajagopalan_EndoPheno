            "id": "396864820",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"AllowStudentsS3TerraformStateReadAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:ListBucket\",\n        \"s3:GetObject\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::bmin5100-terraform-state/*\",\n        \"arn:aws:s3:::bmin5100-terraform-state\"\n      ]\n    },\n    {\n      \"Sid\": \"AllowStudentsS3TerraformWriteAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:DeleteObject\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::bmin5100-terraform-state/${aws:username}-*/*\",\n        \"arn:aws:s3:::bmin5100-terraform-state/${aws:username}-*\"\n      ]\n    },\n    {\n      \"Sid\": \"AllowStudentsFullS3Access\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:*\",\n      \"Resource\": [\n        \"arn:aws:s3:::*/*\",\n        \"arn:aws:s3:::*\"\n      ],\n      \"Condition\": {\n        \"StringNotEquals\": {\n          \"s3:bucketname\": \"bmin5100-terraform-state\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"AllowStudentsECRFullAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ecr:*\",\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"AllowStudentsFullIAMForECSPolicy\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:SetDefaultPolicyVersion\",\n        \"iam:ListPolicyVersions\",\n        \"iam:ListPolicies\",\n        \"iam:ListEntitiesForPolicy\",\n        \"iam:ListAttachedRolePolicies\",\n        \"iam:GetPolicyVersion\",\n        \"iam:GetPolicy\",\n        \"iam:DeletePolicyVersion\",\n        \"iam:DeletePolicy\",\n        \"iam:CreatePolicyVersion\",\n        \"iam:CreatePolicy\"\n      ],\n      \"Resource\": \"arn:aws:iam::*:policy/*\"\n    },\n    {\n      \"Sid\": \"AllowStudentsFullIAMForECSRole\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:UpdateAssumeRolePolicy\",\n        \"iam:PutRolePolicy\",\n        \"iam:ListRoles\",\n        \"iam:ListRolePolicies\",\n        \"iam:ListInstanceProfilesForRole\",\n        \"iam:ListEntitiesForPolicy\",\n        \"iam:ListAttachedRolePolicies\",\n        \"iam:GetRolePolicy\",\n        \"iam:GetRole\",\n        \"iam:DetachRolePolicy\",\n        \"iam:DeleteRolePolicy\",\n        \"iam:DeleteRole\",\n        \"iam:CreateRole\",\n        \"iam:AttachRolePolicy\"\n      ],\n      \"Resource\": \"arn:aws:iam::*:role/*\"\n    },\n    {\n      \"Sid\": \"AllowStudentsIAMPassRole\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:PassRole\",\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"AllowStudentsECSFullAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ecs:*\",\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"AllowStudentsCloudWatchFullAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"logs:*\",\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"AllowStudentsAmplifyFullAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"route53:*\",\n        \"amplify:*\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"AllowStudentsLambdaFullAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"lambda:CreateFunction\",\n        \"lambda:*\",\n        \"ec2:DescribeVpcs\",\n        \"ec2:DescribeSubnets\",\n        \"ec2:DescribeSecurityGroups\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"AllowStudentsApiGatewayFullAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"apigateway:*\",\n      \"Resource\": \"*\"\n    }\n  ]\n}",
